@model MiniBankDTOs.LoginDto
@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card">
            <div class="card-header">
                <h4>MiniBank Digital Banking</h4>
            </div>
            <div class="card-body">
                @if (TempData["Message"] != null)
                {
                    <div class="alert alert-info">@TempData["Message"]</div>
                }
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                <form asp-action="Login" method="post" autocomplete="off">
                    <div class="mb-3">
                        <label class="form-label">Account number</label>
                        <input asp-for="AccountNumber" class="form-control" />
                        <span asp-validation-for="AccountNumber" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Login</button>
                    <a asp-action="FaceLogin" class="btn btn-outline-secondary">Login by face</a>
                    <a asp-action="Register" class="btn btn-link">Create new account</a>
                </form>
            </div>
        </div>
    </div>
</div>
